# ---------------------------------------------------------------------------
# UnicornTail — local environment configuration
# Copy this file to `.env` (cp .env.example .env) before running Docker.
# docker-compose reads `.env` automatically for variable substitution.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=unicorntail
POSTGRES_PASSWORD=unicorntail_dev_password
POSTGRES_DB=unicorntail
POSTGRES_PORT=5432

# --- Backend (NestJS) -------------------------------------------------------
BACKEND_PORT=3001
# Used by the backend to connect to the DB. Inside Docker the host is `db`
# (the compose service name), NOT localhost.
DATABASE_URL=postgresql://unicorntail:unicorntail_dev_password@db:5432/unicorntail

# --- Frontend (Next.js) -----------------------------------------------------
FRONTEND_PORT=3000
# Public base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Root domain used by middleware to resolve wildcard subdomain tenants
# (e.g. acme.unicorntail.com -> "acme"). *.localhost is always handled for dev.
NEXT_PUBLIC_ROOT_DOMAIN=unicorntail.com
